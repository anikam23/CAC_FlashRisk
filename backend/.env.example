# Copy to .env and fill in locally. Never commit real credentials.
# JSON list of origins allowed to call the API.
FLASHRISK_CORS_ORIGINS=["http://localhost:3417","http://127.0.0.1:3417"]

# Copernicus Climate Data Store API key for ERA5-Land retrieval.
# Get a key from https://cds.climate.copernicus.eu/ — leave empty in this example.
CDS_API_KEY=

# Google Earth Engine Cloud project for SMAP and MODIS.
# Authenticate Earth Engine once locally for this Python environment;
# production code calls ee.Initialize(project=...) only — never ee.Authenticate().
EE_PROJECT=
